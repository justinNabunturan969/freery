/*
 * Freery — the local secrets for the port station.
 *
 * THIS FILE IS A SECRET. It holds the device key that proves a packet came
 * from the port station. It is never committed (see .gitignore) and it is
 * never printed on the screen.
 *
 * The network the port station uses does NOT have to be filled in here any
 * more. It is given from the admin console on the PC, and the board remembers
 * it. The two lines below are only used once, for a board that has never been
 * set up, and they may be left as they are.
 */

#ifndef FREERY_SECRETS_H
#define FREERY_SECRETS_H

/* --- The name of this board ----------------------------------------------- */
/*
 * The console uses this name to say which board it is talking about, so each
 * board at a station has its own. Letters, numbers, dot, dash and underscore.
 *
 * The name of the first board at the head station is PS-1.
 */
#define STATION_ID "PS-1"

/* --- The board's own setup page -------------------------------------------- */
/*
 * The password of the little network the board puts up when it has no network
 * of its own. Join the Wi-Fi called Freery-Setup with this password, then open
 * http://192.168.4.1 in a browser.
 *
 * It has to be at least eight characters.
 */
#define SETUP_AP_PASSWORD "freery-setup"

/* --- The network the port station is on ---------------------------------- */
/*
 * These two are only used once, for a board that has never been set up. After
 * that the network comes from the console on the PC, and the board remembers
 * it.
 */
#define WIFI_SSID "your-router-name"
#define WIFI_PASS "your-router-password"

/* --- Where the PC is ----------------------------------------------------- */
/*
 * The address of this PC on the same network, and the port of the admin
 * console. It is 3001, not 3000 (the passenger website) and not 4000 (the
 * read-only API). The counter process on 3002 never serves the ingest route.
 *
 * This PC's address today is 192.168.101.83. It changes when it joins another
 * network, so check it with ipconfig, or open the console on the Hardware page
 * and read it off the "This PC is on" card. The console always shows the
 * current address.
 */
#define PC_BASE_URL "http://192.168.101.83:3001"

/* --- The device key ------------------------------------------------------ */
/*
 * This is the DEVICE_API_KEY value from C:\freery\apps\admin\.env.local.
 * Copy it exactly. It is a secret and it is never shown on the display.
 */
#define DEVICE_KEY "the value of DEVICE_API_KEY from the PC"

#endif /* FREERY_SECRETS_H */
