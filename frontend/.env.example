USE_MOCK=true

# Address of the read-only API on the head station PC, reached through the
# Cloudflare Tunnel. Example: https://api.yourdomain.com
PC_API_URL=
# Value of the x-api-secret header. Server side only. Never use NEXT_PUBLIC_.
API_SECRET=

# Browser refresh interval in milliseconds (not a secret).
NEXT_PUBLIC_POLL_MS=5000
# Seconds after which a GPS packet is considered stale (not a secret).
NEXT_PUBLIC_STALE_SECONDS=60
# Demo acceleration for the mock ferries. 1 = time accurate, higher = faster
# demo movement. Set to 1 when you want the simulation to run in real time.
NEXT_PUBLIC_MOCK_TIME_SCALE=4
